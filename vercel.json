{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm --filter @workspace/novel-reader exec expo export --platform web && pnpm --filter @workspace/novel-reader exec node scripts/prepare-landing.js",
  "outputDirectory": "artifacts/novel-reader/dist",
  "installCommand": "pnpm install --frozen-lockfile",
  "cleanUrls": true,
  "framework": null,
  "redirects": [
    {
      "source": "/downloads/prime-novel-android.apk",
      "destination": "https://expo.dev/artifacts/eas/Kndpei4ouptLmr1VcN2eLPyYFDh6uesjXVtKyPw8ySA.apk",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/app/_expo/:path*",
      "destination": "/_expo/:path*"
    },
    {
      "source": "/app/assets/:path*",
      "destination": "/assets/:path*"
    },
    {
      "source": "/app/favicon.ico",
      "destination": "/favicon.ico"
    },
    {
      "source": "/app",
      "destination": "/app"
    },
    {
      "source": "/app/:path*",
      "destination": "/app"
    }
  ]
}
